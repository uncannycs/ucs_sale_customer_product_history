<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_stock_picking_wizard_tree" model="ir.ui.view">
        <field name="name">stock.picking.wizard.form</field>
        <field name="model">stock.picking.wizard</field>
        <field name="arch" type="xml">
            <list string="Picking Lines" editable="bottom" create="0">
                <field name="picking_id" readonly="1"/>
                <field name="product_id" readonly="1"/>
                <field name="product_uom_qty" readonly="1"/>
                <field name="quantity" readonly="1"/>
            </list>
        </field>
    </record>
    <record id="view_stock_picking_wizard_form" model="ir.ui.view">
        <field name="name">stock.picking.wizard.form</field>
        <field name="model">stock.picking.wizard</field>
        <field name="arch" type="xml">
            <form string="Picking Line">
                <group>
                    <field name="picking_id"/>
                    <field name="product_id"/>
                    <field name="product_uom_qty"/>
                    <field name="quantity"/>
                </group>
            </form>
        </field>
    </record>
</odoo>


